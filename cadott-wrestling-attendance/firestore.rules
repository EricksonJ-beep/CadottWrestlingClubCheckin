rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anonymous authenticated users to read/write attendance data
    match /attendance/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow anonymous authenticated users to read/write roster data
    match /roster/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Keep user data private (not used in this app currently)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}